# ============================================================
# DreamX Coupon Bot — Environment Variables
# Copy this file to .env and fill in your real values.
#
# Only 3 required values. Everything else is managed
# dynamically from the Admin Panel (stored in database).
# ============================================================

# ── Required ─────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=8825167443:AAGtBmad4JWvLoXI42_M8y5hqH8Qva7zvqQ

# Comma-separated Telegram IDs of seed admins
# These are permanent super-admins that cannot be removed.
# Additional admins can be added/removed via Admin Panel.
ADMIN_IDS=769748540

# PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:npg_poH3RWwUK0me@ep-plain-darkness-aolx0go9.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Optional (Logging) ──────────────────────────────────

LOG_LEVEL=INFO
LOG_FILE=bot.log

# ============================================================
# EVERYTHING BELOW IS MANAGED FROM ADMIN PANEL — NOT HERE!
# ============================================================
#
# Payment credentials → Admin Panel → Payments
# Payment timeout     → Admin Panel → Bot Settings
# Min recharge        → Admin Panel → Bot Settings
# Poll interval       → Admin Panel → Bot Settings
# Support/Disclaimer  → Admin Panel → Support
# Gateway toggles     → Admin Panel → Payments
# Force Join Channel  → Admin Panel → Bot Settings
# Additional admins   → Admin Panel → Bot Settings → Manage Admins
