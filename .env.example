# ============================================================
# DreamX Coupon Bot — Environment Variables
# Copy this to .env and fill in your real values
# ============================================================

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Paytm (only MID needed — no key required for status check)
PAYTM_MERCHANT_ID=your_paytm_mid
PAYTM_UPI_ID=paytmqr2810050501011s25rtxh7ixy@paytm
PAYTM_QR_CODE=1jr3q358rp

# BharatPe (merchant ID + token for transaction API)
BHARATPE_MERCHANT_ID=your_bharatpe_merchant_id
BHARATPE_TOKEN=your_bharatpe_token

# Payment Settings
PAYMENT_TIMEOUT_SECONDS=600
PAYMENT_POLL_INTERVAL=2
UPI_PAYEE_NAME=Paytm Merchant

# Bot Settings
BOT_USERNAME=YourBotUsername
SUPPORT_USERNAME=YourSupportUsername

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
