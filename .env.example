# ============================================================
# DreamX Coupon Bot — Environment Variables
# Copy this file to .env and fill in your real values.
#
# NOTE: Payment credentials (Paytm, BharatPe, Razorpay) and
# support info are managed from the Admin Panel — NOT here.
# ============================================================

# ── Required ─────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram IDs of admins
ADMIN_IDS=123456789

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Optional ─────────────────────────────────────────────

# Payment timeout in seconds (default: 600 = 10 minutes)
PAYMENT_TIMEOUT_SECONDS=600

# Minimum recharge amount for BharatPe (default: 10)
BHARATPE_MIN_RECHARGE=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
